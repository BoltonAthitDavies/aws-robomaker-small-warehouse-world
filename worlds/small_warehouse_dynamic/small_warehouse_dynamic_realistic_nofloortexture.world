        <filename>model://aws_robomaker_warehouse_Person_01/meshes/stand.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>14.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="stand">
          <waypoint><time>0.00</time><pose>9.500 15.400 1.00 0 0 0.0000</pose></waypoint>
          <waypoint><time>3.00</time><pose>9.500 15.400 1.00 0 0 0.0000</pose></waypoint>
        </trajectory>
        <trajectory id="1" type="walk">
          <waypoint><time>0.00</time><pose>9.500 15.400 1.00 0 0 0.0000</pose></waypoint>
          <waypoint><time>2.08</time><pose>12.000 15.400 1.00 0 0 0.0000</pose></waypoint>
          <waypoint><time>4.17</time><pose>14.500 15.400 1.00 0 0 0.0000</pose></waypoint>
          <waypoint><time>4.67</time><pose>14.500 15.400 1.00 0 0 -1.5708</pose></waypoint>
        </trajectory>
        <trajectory id="2" type="stand">
          <waypoint><time>0.00</time><pose>14.500 15.400 1.00 0 0 -1.5708</pose></waypoint>
          <waypoint><time>5.00</time><pose>14.500 15.400 1.00 0 0 -1.5708</pose></waypoint>
        </trajectory>
        <trajectory id="3" type="walk">
          <waypoint><time>0.00</time><pose>14.500 15.400 1.00 0 0 -1.5708</pose></waypoint>
          <waypoint><time>0.50</time><pose>14.500 15.400 1.00 0 0 0.0000</pose></waypoint>
          <waypoint><time>2.08</time><pose>16.400 15.400 1.00 0 0 0.0000</pose></waypoint>
          <waypoint><time>3.67</time><pose>18.300 15.400 1.00 0 0 0.0000</pose></waypoint>
          <waypoint><time>4.17</time><pose>18.300 15.400 1.00 0 0 1.5708</pose></waypoint>
        </trajectory>
        <trajectory id="4" type="stand">
          <waypoint><time>0.00</time><pose>18.300 15.400 1.00 0 0 1.5708</pose></waypoint>
          <waypoint><time>4.00</time><pose>18.300 15.400 1.00 0 0 1.5708</pose></waypoint>
        </trajectory>
        <trajectory id="5" type="walk">
          <waypoint><time>0.00</time><pose>18.300 15.400 1.00 0 0 1.5708</pose></waypoint>
          <waypoint><time>0.50</time><pose>18.300 15.400 1.00 0 0 3.1416</pose></waypoint>
          <waypoint><time>2.12</time><pose>16.350 15.400 1.00 0 0 3.1416</pose></waypoint>
          <waypoint><time>3.75</time><pose>14.400 15.400 1.00 0 0 3.1416</pose></waypoint>
          <waypoint><time>5.38</time><pose>12.450 15.400 1.00 0 0 3.1416</pose></waypoint>
          <waypoint><time>7.00</time><pose>10.500 15.400 1.00 0 0 3.1416</pose></waypoint>
          <waypoint><time>7.50</time><pose>10.500 15.400 1.00 0 0 -1.5708</pose></waypoint>
        </trajectory>
        <trajectory id="6" type="stand">
          <waypoint><time>0.00</time><pose>10.500 15.400 1.00 0 0 -1.5708</pose></waypoint>
          <waypoint><time>5.00</time><pose>10.500 15.400 1.00 0 0 -1.5708</pose></waypoint>
        </trajectory>
        <trajectory id="7" type="walk">
          <waypoint><time>0.00</time><pose>10.500 15.400 1.00 0 0 -1.5708</pose></waypoint>
          <waypoint><time>0.50</time><pose>10.500 15.400 1.00 0 0 3.1416</pose></waypoint>
          <waypoint><time>1.33</time><pose>9.500 15.400 1.00 0 0 3.1416</pose></waypoint>
          <waypoint><time>1.83</time><pose>9.500 15.400 1.00 0 0 0.0000</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- ackermann_robot -->
    <include>
      <uri>model://ackermann_robot</uri>
      <name>ackermann_robot_001</name>
      <pose>5.25 20 0 0 0 -1.5708</pose>
    </include>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.7 0.7 0.7</ambient_light>
        <background_color>0.25 0.28 0.32</background_color>
        <camera_pose>-18.000000 -18.000000 8.500000 0.000000 0.286521 0.785398</camera_pose>
      </plugin>

      <!-- Embedding <gui> in the world replaces gui.config outright rather than
           merging with it, so every plugin the GUI needs must be listed here. -->
      <plugin filename="GzSceneManager" name="Scene Manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
        </ignition-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
        </ignition-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
        </ignition-gui>
      </plugin>

      <plugin filename="SelectEntities" name="Select Entities">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
        </ignition-gui>
      </plugin>

      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
        </ignition-gui>
      </plugin>

      <plugin filename="MarkerManager" name="Marker manager">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
        </ignition-gui>
      </plugin>

      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <ignition-gui>
          <property key="resizable" type="bool">false</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="state" type="string">floating</property>
        </ignition-gui>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
        <use_event>true</use_event>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="Screenshot" name="Screenshot">
        <ignition-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="height">50</property>
          <property type="double" key="width">50</property>
          <property type="string" key="state">floating</property>
          <anchors target="World control">
            <line own="left" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
      </plugin>

      <plugin filename="ComponentInspector" name="Component inspector">
        <ignition-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree">
        <ignition-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
      </plugin>
    </gui>

  </world>
</sdf>
