<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.7">
  <world name="default">

    <gravity>0 0 -9.8</gravity>

    <!-- gz-sim selects its physics engine via gz-physics (DART by default),
         so the SDF type attribute is informational only. -->
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Fortress only auto-loads its default systems when a world declares no
         plugins at all, so every system this world needs is listed here. -->
    <plugin filename="ignition-gazebo-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Present so a robot spawned into this world gets working sensors
         without having to edit the world. Sensors covers the rendering sensors
         (camera, lidar, depth); the IMU is a separate system and an
         <sensor type="imu"> is silently inert without it. -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.25 0.28 0.32 1</background>
      <shadows>false</shadows>
      <!-- The default 1 m grid draws straight through the warehouse floor. -->
      <grid>false</grid>
    </scene>

    <light name="warehouse_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- cast_shadows is off: each shadow-casting point light costs a six-face
         cubemap render per frame in ogre2, and this one sits directly under the
         roof plane where it would shadow the whole interior. -->
    <light name="Warehouse_CeilingLight_003" type="point">
      <pose>0 0 8.5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>80</range>
        <!-- constant raised from the original 0.3: at d=0 the Ogre attenuation
             divisor 1/(c + l*d + q*d^2) overshoots 1.0 and blows out the ceiling. -->
        <constant>0.4</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
      <direction>0 0 -1</direction>
    </light>

    <include>
      <uri>model://aws_robomaker_warehouse_RoofB_01</uri>
      <name>aws_robomaker_warehouse_RoofB_01_001</name>
      <pose>0.0 0.0 0 0 0 0</pose>
    </include>

    <!-- <include>
      <uri>model://aws_robomaker_warehouse_ShelfF_01</uri>
      <name>aws_robomaker_warehouse_ShelfF_01_001</name>
      <pose>-5.795143 -0.956635 0 0 0 0</pose>
    </include> -->

    <include>
      <uri>model://aws_robomaker_warehouse_WallB_01</uri>
      <name>aws_robomaker_warehouse_WallB_01_001</name>
      <pose>0.0 0.0 0 0 0 0</pose>
    </include>

    <!-- <include>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <name>aws_robomaker_warehouse_ShelfE_01_001</name>
      <pose>4.73156 0.57943 0 0 0 0</pose>
