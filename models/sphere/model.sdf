<?xml version='1.0'?>
<sdf version="1.7">
  <model name='sphere'>
    <!-- Static so the sphere stays exactly where it is placed, even with its
         centre on the ground plane. Set to 0 for a ball that falls and rolls;
         raise the include pose by the radius first so it starts above ground. -->
    <static>1</static>
    <link name='body'>
      <inertial>
        <mass>1</mass>
        <pose>0 0 0 0 0 0</pose>
        <!-- Solid sphere: I = 2/5 * m * r^2 -->
        <inertia>
          <ixx>0.025</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.025</iyy>
          <iyz>0</iyz>
          <izz>0.025</izz>
        </inertia>
      </inertial>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>0</self_collide>
      <kinematic>0</kinematic>
      <gravity>1</gravity>
      <visual name='visual'>
        <geometry>
          <sphere>
            <radius>0.1</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name='collision'>
        <laser_retro>0</laser_retro>
        <max_contacts>10</max_contacts>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.25</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
          <bounce/>
          <contact>
            <ode/>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
