        <geometry>
          <box>
            <size>0.02 0.02 0.02</size>
          </box>
        </geometry>
      </collision>
      <!-- Hand-added, not converter output: the stereo partner for cam0, one
           calibrated baseline (93.6 mm) along cam0's optical +X, which is the
