<?xml version="1.0" ?>
<!--
  Generated from urdf/ackermann_robot.urdf via `ign sdf -p`, then edited.
  Regenerate with that command if the URDF changes; the four edits are:
    1. Gazebo Classic <script>Gazebo/Blue</script> material blocks removed.
    2. Converter float noise collapsed.
    3. AckermannSteering system added (see the comment near the bottom).
    4. IMU and stereo camera <sensor> elements added, plus the cam1 / cam1_undis
       frames and the cam1 visual+collision they need. The URDF carries matching
       definitions, but a regeneration will still need checking against them:
       cam1 is a hand-placed stereo partner, not converter output.

  Link layout note: every fixed-joint child (base_link, imu_link, cam_link1,
  cam_link2, cam0, cam0_undis, cam0_depth) is lumped into base_footprint by the
  URDF converter, which is exactly what Gazebo does when spawning the URDF
  directly. Their frames survive as <frame> elements at the end of the file.
  Sensors therefore hang off base_footprint and locate themselves with
  <pose relative_to='...'> against those surviving frames.
-->

<sdf version='1.9'>
  <model name='ackermann_robot'>
    <link name='base_footprint'>
      <inertial>
        <pose>0.003346535 0 0.097940594 0 0 0</pose>
        <mass>10.1</mass>
        <inertia>
          <ixx>0.148403564</ixx>
          <ixy>0</ixy>
          <ixz>-0.003179208</ixz>
          <iyy>0.314714851</iyy>
          <iyz>0</iyz>
          <izz>0.453831287</izz>
        </inertia>
      </inertial>
      <collision name='base_footprint_fixed_joint_lump__base_link_collision'>
        <pose>0 0 0.097 0 0 0</pose>
        <geometry>
          <box>
            <size>0.6 0.463 0.05</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__cam_link1_collision_1'>
        <pose>0.409 0 0.3815 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2025 0.02 0.02</size>
          </box>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__cam_link2_collision_2'>
        <pose>0.496 0 0.3815 0 0 0</pose>
        <geometry>
