      <!--
        SENSORS. These feed VINS-Fusion via
        vins_fusion_ros2/config/wil_sim/stereo_imu.yaml; the ros_gz_bridge that
        puts them on ROS topics lives in launch/small_warehouse.launch.py.

        They attach to base_footprint because it is the only link left after the
        URDF converter's lumping (see the header note); the pose is what places
        them, not the parent link.

        Requires ignition-gazebo-sensors-system (cameras) and
        ignition-gazebo-imu-system (IMU) in the world. Both worlds in this
        package declare them.
      -->

      <!--
        Attached to 'cam0', NOT 'cam0_undis'. A gz camera sensor looks down its
        own +X axis, so it wants the x-forward frame. cam0_undis / cam0_depth are
        ROS optical frames (x-right, y-down, z-forward) and would aim the camera
        out the robot's right side.

        Ideal pinhole: Fortress ships no wide-angle camera implementation
        (there is no libignition-sensors6-wideangle_camera.so), so the real rig's
        ~180 deg KANNALA_BRANDT fisheye in config/wil/cam0_fisheye.yaml cannot be
        reproduced here. Hence the separate config/wil_sim/ calibration.

        90 deg horizontal FOV at 1280 px gives
          fx = fy = (width/2) / tan(hfov/2) = 640,  cx = 640, cy = 360
        which is what config/wil_sim/cam0_pinhole.yaml states. Changing
        horizontal_fov or the image size here means changing that file too.
      -->
      <sensor name='cam0' type='camera'>
        <pose relative_to='cam0'>0 0 0 0 -0 0</pose>
        <!-- Set explicitly. The default would be
             /world/default/model/ackermann_robot_001/link/base_footprint/sensor/cam0/image,
             since the world <include> renames the model to ackermann_robot_001.
             gz derives the camera_info topic by REPLACING the last element of
             this one, so info lands on /cam0/camera_info, NOT
             /cam0/image_raw/camera_info. -->
        <topic>cam0/image_raw</topic>
        <update_rate>20</update_rate>
        <always_on>1</always_on>
        <visualize>0</visualize>
        <camera>
          <horizontal_fov>1.5707963268</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <!-- A little sensor noise so the feature tracker is not fed a
               noiseless render, which is unrealistically easy. -->
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
      </sensor>

      <sensor name='cam1' type='camera'>
        <pose relative_to='cam1'>0 0 0 0 -0 0</pose>
        <topic>cam1/image_raw</topic>
        <update_rate>20</update_rate>
        <always_on>1</always_on>
        <visualize>0</visualize>
        <camera>
          <horizontal_fov>1.5707963268</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
      </sensor>

      <!--
        imu_link carries no rotation, so this reports in ROS REP-103 axes
        (x-forward, y-left, z-up) and reads (0, 0, +9.8) at rest. That is
        deliberately NOT the real RealSense's x-right/y-down/z-forward
        convention, which is why config/wil_sim/stereo_imu.yaml needs its own
        body_T_cam matrices rather than the near-identity ones in config/wil/.

        200 Hz matches the real rig's measured 199.5 Hz and needs no physics
        change: the worlds step at 1 kHz (<max_step_size>0.001</max_step_size>).

        gz applies <stddev> per sample, so a noise DENSITY N at rate f becomes
        N * sqrt(f). The densities below are the usual ADIS16448 figures:
          gyro  0.0003394 rad/s/sqrt(Hz) * sqrt(200) = 0.0048
          accel 0.004     m/s^2/sqrt(Hz) * sqrt(200) = 0.0566
        VINS's acc_n / gyr_n in config/wil_sim/stereo_imu.yaml are set a few
        times looser than these densities, per the usual VINS advice.
      -->
      <sensor name='imu' type='imu'>
        <pose relative_to='imu_link'>0 0 0 0 -0 0</pose>
        <topic>imu</topic>
        <update_rate>200</update_rate>
        <always_on>1</always_on>
        <imu>
          <angular_velocity>
            <x>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.0048</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.0048</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.0048</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.0566</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.0566</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type='gaussian'>
                <mean>0</mean>
                <stddev>0.0566</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name='front_left_steering_joint' type='revolute'>
      <pose relative_to='base_footprint'>0.21 0.21 0.072 0 0 0</pose>
      <parent>base_footprint</parent>
      <child>front_left_steering_knuckle</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.6109</lower>
          <upper>0.6109</upper>
          <effort>100</effort>
          <velocity>1</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.01</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
