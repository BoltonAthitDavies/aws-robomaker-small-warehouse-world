          <ixz>0</ixz>
          <iyy>0.000531</iyy>
          <iyz>0</iyz>
          <izz>0.000856</izz>
        </inertia>
      </inertial>
      <collision name='rear_left_wheel_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.065</length>
            <radius>0.0585</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='rear_left_wheel_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.065</length>
            <radius>0.0585</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0 0 0 1</diffuse>
          <ambient>0 0 0 1</ambient>
        </material>
      </visual>
    </link>
    <joint name='rear_right_wheel_joint' type='revolute'>
      <pose relative_to='base_footprint'>-0.21 -0.21 0.072 -1.5708 0 0</pose>
      <parent>base_footprint</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-10000000000000000</lower>
          <upper>10000000000000000</upper>
        </limit>
        <dynamics>
          <damping>0.0</damping>
          <friction>0.0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='rear_right_wheel'>
      <pose relative_to='rear_right_wheel_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.000531</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000531</iyy>
          <iyz>0</iyz>
          <izz>0.000856</izz>
        </inertia>
      </inertial>
      <collision name='rear_right_wheel_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.065</length>
            <radius>0.0585</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='rear_right_wheel_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.065</length>
            <radius>0.0585</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0 0 0 1</diffuse>
          <ambient>0 0 0 1</ambient>
        </material>
      </visual>
    </link>
    <frame name='cam0_depth_joint' attached_to='cam0'>
      <pose>0 0 0 -1.5708 -0 -1.5708</pose>
    </frame>
    <frame name='cam0_depth' attached_to='cam0_depth_joint'/>
    <frame name='cam0_undis_joint' attached_to='cam0'>
      <pose>0 0 0 -1.5708 -0 -1.5708</pose>
    </frame>
    <frame name='cam0_undis' attached_to='cam0_undis_joint'/>
    <frame name='cam0_joint' attached_to='cam_link2'>
      <pose>0 0 0.058 0 -0 0</pose>
    </frame>
    <frame name='cam0' attached_to='cam0_joint'/>
    <!--
      cam1, the stereo partner. Baseline 0.0936 m, reused verbatim from the real
      rig's calibrated 93.598 mm (config/wil/stereo_imu.yaml, body_T_cam1) so sim
      and hardware geometry agree.

      Sign: the calibration puts cam1 on cam0's optical +X, and optical +X is the
      robot's right, which is base -Y. If the stereo pair ever looks inverted,
      this sign and the matching one in config/wil_sim/stereo_imu.yaml are the
      first thing to check.

      cam1_undis mirrors cam0_undis: the ROS optical frame, for anyone wiring up
      TF later. Nothing in this file points a sensor at it.
    -->
    <frame name='cam1_joint' attached_to='cam0'>
      <pose>0 -0.0936 0 0 -0 0</pose>
    </frame>
    <frame name='cam1' attached_to='cam1_joint'/>
    <frame name='cam1_undis_joint' attached_to='cam1'>
      <pose>0 0 0 -1.5708 -0 -1.5708</pose>
    </frame>
    <frame name='cam1_undis' attached_to='cam1_undis_joint'/>
    <frame name='cam_link2_joint' attached_to='cam_link1'>
      <pose>0.087 0 0 0 -0 0</pose>
    </frame>
    <frame name='cam_link2' attached_to='cam_link2_joint'/>
    <frame name='cam_link1_joint' attached_to='base_link'>
      <pose>0.409 0 0.2845 0 -0 0</pose>
    </frame>
    <frame name='cam_link1' attached_to='cam_link1_joint'/>
    <frame name='imu_joint' attached_to='base_link'>
      <pose>0.338 0 0.095 0 -0 0</pose>
    </frame>
    <frame name='imu_link' attached_to='imu_joint'/>
    <frame name='base_footprint_joint' attached_to='base_footprint'>
      <pose>0 0 0.097 0 -0 0</pose>
    </frame>
    <frame name='base_link' attached_to='base_footprint_joint'/>

    <!--
      REPLACES THE URDF's mimic tags. libsdformat12 / Fortress has no mimic
      joint support and drops them silently on conversion, which would leave
      both front steering joints free-swinging and unactuated. AckermannSteering
      drives the rear wheels and computes the correct differing left/right
      steer angles itself, so mimic is not needed.

      Command it on:  /model/MODEL_NAME/cmd_vel   (geometry_msgs/Twist)
      i.e. the WORLD-scoped name, not this file's. small_warehouse.world includes
      the model as ackermann_robot_001, so there the topic is
      /model/ackermann_robot_001/cmd_vel.
      Delete this block if you intend to drive the joints from ros2_control.
    -->
    <plugin filename="ignition-gazebo-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <!-- Rear-wheel drive, per the "(DRIVEN)" comments in the URDF. -->
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <!-- Measured off the URDF joint origins: axles at x = +/-0.21,
           wheels and kingpins at y = +/-0.21, wheel radius 0.0585. -->
      <kingpin_width>0.42</kingpin_width>
      <wheel_base>0.42</wheel_base>
      <wheel_separation>0.42</wheel_separation>
      <wheel_radius>0.0585</wheel_radius>
      <!-- Matches the +/-0.6109 rad limit on the steering joints. -->
      <steering_limit>0.6109</steering_limit>
      <!--
        Speed cap. AckermannSteering reads these once at load and offers no runtime
        API, and sdformat 12 has no parameter substitution, so these values ARE the
        configuration point. small_warehouse.launch.py's max_speed / max_accel
        arguments work by rewriting a copy of this file before gz parses it; keep
        the values here and the launch-file defaults in step.

        10 m/s on 0.0585 m wheels means 171 rad/s at the axle. That is fast for a
        10.1 kg vehicle on a 1 ms physics step, so expect tyre slip and a real gap
        between commanded and achieved speed near the top of the range. Anything
        that needs faithful wheel contact should stay well below it.

        Reverse is symmetric, and the acceleration limit is what decides whether the
        top speed is reachable at all: at 3 m/s^2 it takes 3.3 s and about 17 m of
        run-up to reach 10 m/s, which is most of the warehouse.
      -->
      <min_velocity>-10</min_velocity>
      <max_velocity>10</max_velocity>
      <min_acceleration>-3</min_acceleration>
      <max_acceleration>3</max_acceleration>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!--
      GROUND TRUTH odometry, for scoring VINS (or anything else) against reality.

      This is a genuinely different quantity from the odometry AckermannSteering
      publishes above. That one integrates the wheel joints, so it is dead
      reckoning: it reports the COMMANDED speed even when the tyres are slipping
      and the robot is barely moving. OdometryPublisher instead reads the model's
      true world pose out of the ECM and finite-differences it for the twist, so
      it cannot drift and cannot be fooled by slip.

      The two topics are deliberately named differently. Do NOT let this one
      default: the default is /model/MODEL_NAME/odometry, which is exactly what
      AckermannSteering already publishes, and the two would fight over it.

      /ground_truth/* is unscoped, which assumes ONE robot in the world. Give each
      robot its own topic here if you ever spawn a second.

      gaussian_noise is left off on purpose. This is the reference signal; if you
      want a noisy odometry source, add noise downstream rather than corrupting
      the thing you are measuring against.
    -->
    <!--
      NOTE the name: ignition::gazebo::, not gz::sim:: as used by AckermannSteering
      just above. In this Fortress build (6.17.1) libignition-gazebo6-ackermann-
      steering-system registers BOTH aliases, but the odometry-publisher library
      registers only the ignition:: one. Using gz::sim:: here fails with
      "Could not find a plugin with that name or alias" and the plugin is silently
      skipped; the world still loads, you just get no topic. Verify with:
        strings /usr/lib/x86_64-linux-gnu/ign-gazebo-6/plugins/<lib>.so.6.17.1 \
          | grep -E '^(gz|ignition)::(sim|gazebo)::systems::'
    -->
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>/ground_truth/odometry</odom_topic>
      <tf_topic>/ground_truth/pose</tf_topic>
      <!-- 3, not 2: keeps z so a robot that climbs or tips is still described. -->
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
