<?xml version="1.0"?>
<package format="3">
  <name>aws_robomaker_small_warehouse_world</name>
  <version>2.0.0</version>
  <description>
    AWS RoboMaker package for a warehouse world to use in manufacturing and logistics robot applications.
    Ported from Gazebo Classic to Gazebo (Ignition) Fortress / gz-sim 6.
  </description>
  <license>MIT-0</license>
  <author email="ros-contributions@amazon.com">AWS RoboMaker</author>
  <maintainer email="ros-contributions@amazon.com">AWS RoboMaker</maintainer>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- This package builds and links nothing; it ships world/model assets and
       launch files, so everything it needs is a runtime dependency. -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Not started by any launch file here; it needs a real TTY, so it is run with
       `ros2 run` (see README). Declared so rosdep installs it with the package. -->
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
